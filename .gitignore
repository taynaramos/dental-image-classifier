# Arquivos de bytecode gerados ao rodar o Python
__pycache__/
*.py[cod]
*$py.class

# Arquivos de empacotamento e distribuição
dist/
build/
*.egg-info/

# Ambientes virtuais (Virtual Environments)
venv/
env/
ENV/
*.env

# Configurações locais e bancos de dados de IDEs
.idea/
.vscode/
*.sqlite3

# Logs de execução
*.log

# Dataset de imagens
data/dataset/
# Layout ImageFolder materializado automaticamente pelo pipeline PyTorch
data/dataset_imagefolder/

# Modelos treinados (binários grandes, regeneráveis via torch-train)
artifacts/

# Ambiente virtual (variante com ponto, ex.: python -m venv .venv)
.venv/

# Checkpoints do Jupyter
.ipynb_checkpoints/
